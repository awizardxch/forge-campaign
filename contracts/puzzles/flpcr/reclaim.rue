// reclaim.rue: once a campaign's claim window has passed, its creator gets
// back everything holders left (budget never earned plus earnings never
// claimed) and the campaign is removed. Until this lands, holders can still
// claim.
//
// Who may reclaim: the creator, by signature or a message from the creator's
// address, or through a delegate the creator granted (a hot wallet for a
// cold-wallet creator); or the distributor's admin (AUTH_ADMIN: a coin at
// admin_ph, the dev multisig, sends "k" + message), so a fully claimed or
// abandoned campaign cannot hold a table slot forever. The payment always
// goes to the creator, whoever authorizes it.
//
// Not while holders' accrual is still in flight (review 2026-11-09, NEW-3):
// a reclaim is refused while a dispute is open (its outcome may be a
// corrected root that owes holders more), and while the pending root raises
// this campaign's total above the active root's. Otherwise a creator could
// dispute its own final root, or simply time the reclaim inside the final
// root's dispute window, and take what that root owes holders. A pending root
// that leaves the campaign's total where it was does not block: roots keep
// naming every live campaign, so blocking on any mention would let a steady
// stream of roots hold a finished campaign forever.

import shared::*;

// What the pending root owes holders of `id` beyond the active root: nothing
// when no root is pending. Totals never fall (post_root), so > 0 means more.
fn pending_raise(state: State, id: Bytes32) -> Int {
    if state.pending is nil {
        0
    } else {
        let before = if state.active is nil { 0 } else { total_for(state.active.totals, id) };
        total_for(state.pending.totals, id) - before
    }
}

fn main(
    CONFIG: Config,
    truth: Truth,
    h: Int,
    campaign_id: Bytes32,
    auth: Int,
    auth_data: Any,
) -> (Truth, List<Condition>) {
    let (pinned, conditions) = prologue(truth, h);
    let state = pinned.state;
    let campaign = get_campaign(state.campaigns, campaign_id);
    assert h >= campaign.end + campaign.claim_window;
    assert state.dispute is nil;
    assert pending_raise(state, campaign_id) == 0;

    let message = tree_hash(["flpcr-reclaim-v1", CONFIG.distributor_id, campaign_id]);
    let authorization = if auth == AUTH_ADMIN {
        [
            receive_from(CONFIG.admin_ph, "k" + message),
        ]
    } else {
        authorize_or_delegate(CONFIG, campaign.creator, auth, auth_data, message, false)
    };

    let amount = campaign.budget - campaign.claimed;
    let new_state = with_campaigns(
        state,
        state.reserve - amount,
        remove_campaign(state.campaigns, campaign_id),
    );

    (
        Truth { ephemeral: pinned.ephemeral, state: new_state },
        if amount > 0 {
            [reserve_payment(campaign.creator, amount), ...merge_list(authorization, conditions)]
        } else {
            merge_list(authorization, conditions)
        },
    )
}
