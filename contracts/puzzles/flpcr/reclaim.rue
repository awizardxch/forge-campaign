// reclaim.rue: once a campaign's claim window has passed, its creator gets
// back everything holders left (budget never earned plus earnings never
// claimed) and the campaign is removed. Until this lands, holders can still
// claim. Anyone may submit it; the payment always goes to the creator.

import shared::*;

fn main(
    CONFIG: Config,
    truth: Truth,
    h: Int,
    campaign_id: Bytes32,
) -> (Truth, List<Condition>) {
    let (pinned, conditions) = prologue(truth, h);
    let state = pinned.state;
    let campaign = get_campaign(state.campaigns, campaign_id);
    assert h >= campaign.end + campaign.claim_window;

    let amount = campaign.budget - campaign.claimed;
    let new_state = with_campaigns(
        state,
        state.reserve - amount,
        state.fees_owed,
        remove_campaign(state.campaigns, campaign_id),
    );

    (
        Truth { ephemeral: pinned.ephemeral, state: new_state },
        if amount > 0 {
            [reserve_payment(campaign.creator, amount), ...conditions]
        } else {
            conditions
        },
    )
}
